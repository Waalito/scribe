---
import ErrorIndicator from "./ErrorIndicator.astro";

const MAX_ERRORS = 3;
---

<div
  id="error-counter"
  class="error-counter"
  aria-label="Contador de errores: máximo 3"
>
  {
    Array.from({ length: MAX_ERRORS }).map((_, index) => (
      <div
        class="error-slot"
        data-error-slot={index}
        aria-hidden="true"
      >
        <div class="error-slot-frame">
          <ErrorIndicator />
        </div>
      </div>
    ))
  }
</div>

<style>
  .error-counter {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .error-slot {
    width: 15px;
    height: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .error-slot-frame {
    width: 13px;
    height: 13px;
    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid rgba(125, 36, 38, 0.45);
    background: rgba(20, 10, 10, 0.45);

    box-sizing: border-box;
  }

  :global(.error-slot-frame .error-indicator) {
    opacity: 0;
    transform: scale(0.8);
    transition:
      opacity 120ms ease,
      transform 120ms ease;
  }

  :global(.error-slot.is-active .error-indicator) {
    opacity: 1;
    transform: scale(1);
  }
</style>